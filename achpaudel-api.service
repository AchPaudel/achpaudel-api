[Unit]
Description=Ach Paudel API Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/achpaudel-api
ExecStart=/usr/bin/java -Xmx256m -Xms128m -jar /opt/achpaudel-api/achpaudel-api-1.0.0.jar
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=achpaudel-api

# Environment variables
Environment="JAVA_OPTS=-Xmx256m -Xms128m"

[Install]
WantedBy=multi-user.target
